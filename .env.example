# SPDX-License-Identifier: MPL-2.0
# Copy to rag/.env to override any default. Every value is optional.

# --- topology ---------------------------------------------------------------
# native (default): one Python process, in-process ONNX embeddings, file-backed
#                   vector store. No Docker, no daemons.
# docker          : the compose stack (Qdrant server + Ollama). Set automatically
#                   by docker-compose.yml — you do not normally set this by hand.
#RAG_MODE=native

# --- the corpus (the part you supply) ---------------------------------------
# Path of the folder to index. Default: the parent of this folder, which is
# almost never what you want — Rag.bat asks and writes it here for you.
# In Docker mode set RAG_REPO_PATH instead — that is the host path compose mounts.
# Windows example: RAG_REPO_MOUNT=S:/Team/Documents
#RAG_REPO_MOUNT=..
#RAG_REPO_LABEL=Team share

# Collection name — change this to keep several corpora side by side.
#RAG_COLLECTION=codebase

# --- embeddings -------------------------------------------------------------
# Native default. Alternatives:
#   jinaai/jina-embeddings-v2-base-code  code-specialised, 768-dim, ~640 MB
#   BAAI/bge-small-en-v1.5               fastest/smallest, 384-dim, ~67 MB
# Changing the model changes the vector width: reindex with -Full afterwards.
#RAG_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
#RAG_EMBED_BACKEND=fastembed

# First-index speed. Embedding is CPU-bound and is the entire cost of the first
# run. Threads now default to this machine's core count, so there is normally
# nothing to set. Use 0 to hand the choice back to onnxruntime, or a specific
# number to leave cores free for other work.
#RAG_EMBED_THREADS=0
#RAG_EMBED_BATCH=32

# How much of a chunk's location is embedded with its text.
#   full - "dir/sub/file.pdf"  (default; makes "where is X done?" work)
#   name - "file.pdf" only     (drops directory names)
#   off  - text alone
# Directory names leak into matching: a folder called "Volume_I" pulls every
# chunk under it toward any query mentioning volumes. Try "off" if content
# questions keep returning the wrong folder. Reindex -Full after changing.
#RAG_EMBED_PATH=full

# Cross-encoder reranking: re-orders the vector search's candidates by reading
# query and passage together. Fixes "topically similar but not the answer",
# which better chunking cannot. Costs a second or two per query. Query-time
# only - no reindex needed after changing it.
#RAG_RERANK=1
#RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
#RAG_RERANK_CANDIDATES=40

# --- what gets indexed ------------------------------------------------------
# Extra plain-text extensions, no code change needed. The language tag defaults
# to the extension without its dot; "=tag" names it explicitly.
#RAG_EXTRA_TEXT_EXTS=.sql,.ini,.log
#RAG_EXTRA_TEXT_EXTS=.sql=sql,.cfg=conf

# Keep PDF running headers/footers instead of stripping them. Off by default:
# a footer repeated on every page lands in every chunk and flattens retrieval.
#RAG_PDF_KEEP_BOILERPLATE=1

# Index documents found inside .zip archives (one level deep, never nested).
#RAG_ARCHIVES=1
#RAG_ARCHIVE_MAX_BYTES=500000000
#RAG_ARCHIVE_MAX_MEMBERS=2000

# --- storage ----------------------------------------------------------------
# Where the embedded vector index and the downloaded model weights live.
#RAG_QDRANT_PATH=./.data/qdrant
#RAG_MODEL_CACHE=./.data/models
# Set this to talk to a Qdrant server instead of the embedded store.
#RAG_QDRANT_URL=http://127.0.0.1:6333

# --- behaviour --------------------------------------------------------------
#RAG_PORT=8404
# Live re-index on file save (2s debounce). Set to 0 on a slow filesystem.
#RAG_WATCH=1
# Index automatically when the collection is empty on startup.
#RAG_INGEST_ON_START=1
# Comma-separated. Defaults already skip .git, target, node_modules, .venv,
# .data and archive/ — add your own here (this REPLACES the default list).
#RAG_EXCLUDE_DIRS=.git,target,node_modules,.venv,.data,archive
