# SPDX-License-Identifier: MPL-2.0
# Copy to rag/.env to override any default. Every value is optional.

# --- topology ---------------------------------------------------------------
# native (default): one Python process, in-process ONNX embeddings, file-backed
#                   vector store. No Docker, no daemons.
# docker          : the compose stack (Qdrant server + Ollama). Set automatically
#                   by docker-compose.yml — you do not normally set this by hand.
#RAG_MODE=native

# --- the corpus (the part you supply) ---------------------------------------
# Path of the folder to index. Default: the parent of this folder, which is
# almost never what you want — Rag.bat asks and writes it here for you.
# In Docker mode set RAG_REPO_PATH instead — that is the host path compose mounts.
# Windows example: RAG_REPO_MOUNT=S:/Team/Documents
#RAG_REPO_MOUNT=..
#RAG_REPO_LABEL=Team share

# Collection name — change this to keep several corpora side by side.
#RAG_COLLECTION=codebase

# --- embeddings -------------------------------------------------------------
# Native default. Alternatives:
#   jinaai/jina-embeddings-v2-base-code  code-specialised, 768-dim, ~640 MB
#   BAAI/bge-small-en-v1.5               fastest/smallest, 384-dim, ~67 MB
# Changing the model changes the vector width: reindex with -Full afterwards.
#RAG_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
#RAG_EMBED_BACKEND=fastembed

# First-index speed. Embedding is CPU-bound and is the entire cost of the first
# run. Threads now default to this machine's core count, so there is normally
# nothing to set. Use 0 to hand the choice back to onnxruntime, or a specific
# number to leave cores free for other work.
#RAG_EMBED_THREADS=0
#RAG_EMBED_BATCH=32

# How much of a chunk's location is embedded with its text.
#   full - "dir/sub/file.pdf"  (default; makes "where is X done?" work)
#   name - "file.pdf" only     (drops directory names)
#   off  - text alone
# Directory names leak into matching: a folder called "Volume_I" pulls every
# chunk under it toward any query mentioning volumes. Try "off" if content
# questions keep returning the wrong folder. Reindex -Full after changing.
#RAG_EMBED_PATH=full

# Cross-encoder reranking: re-orders the vector search's candidates by reading
# query and passage together. Fixes "topically similar but not the answer",
# which better chunking cannot. Costs a second or two per query. Query-time
# only - no reindex needed after changing it.
#RAG_RERANK=1
#RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
#RAG_RERANK_CANDIDATES=40

# --- an OpenAI-shaped embeddings service ------------------------------------
# For a hosted or company-internal endpoint instead of the in-process model.
# The base URL, with "/embeddings" appended.
#RAG_EMBED_BACKEND=http
#RAG_EMBED_URL=https://ai.internal/v1
#RAG_EMBED_MODEL=whatever-the-service-calls-it
#RAG_EMBED_API_KEY=
# Most gateways take "Authorization: Bearer <key>"; some want "api-key: <key>"
# with no prefix at all.
#RAG_EMBED_AUTH_HEADER=Authorization
#RAG_EMBED_AUTH_PREFIX=Bearer
#
# These two matter more than they look. Strong retrieval models are trained
# asymmetrically - nomic expects "search_document: " on passages and
# "search_query: " on questions; e5 wants "passage: " and "query: ". fastembed
# applies them for you. A raw HTTP endpoint does not, so leaving them empty
# against such a model quietly degrades ranking while appearing to work. Set
# them to whatever the service's model was trained with.
#RAG_EMBED_DOC_PREFIX=search_document:
#RAG_EMBED_QUERY_PREFIX=search_query:
#
# Inputs per request; gateways cap this where a local model does not. Failures
# retry with backoff, because a corpus ingest against a rate-limited service is
# the case this has to survive rather than the exception.
#RAG_EMBED_HTTP_BATCH=64
#RAG_EMBED_HTTP_TIMEOUT=120
# For an endpoint behind a corporate CA this machine does not trust yet. A real
# situation and a bad default, so it is opt-out and named plainly.
#RAG_EMBED_VERIFY_TLS=1

# --- running the models on the GPU ------------------------------------------
# Covers both ONNX models: the embedder and the cross-encoder reranker.
#
# It speeds up a first index over a large corpus, which is embedding thousands
# of chunks and is exactly what a GPU is for. What it does for *query* latency
# depends entirely on whether reranking is on, and the arithmetic is worth
# knowing because it is not the arithmetic most people assume:
#
#     embed one short question ....... 33 ms
#     rerank 10 candidates .......... 415 ms
#     rerank 40 candidates (default) . 1.3 s
#     rerank 150 candidates .......... 4.5 s
#
# (measured on one CPU box; the ratios are the point, not the absolutes.)
#
# Turning this on for the same box, an RTX 5090: embedding 17x faster,
# reranking 23x, and a whole search 12.2s -> 0.36s.
#
# So with reranking off, a search is milliseconds and the GPU changes nothing
# you can feel. With it on, the reranker is essentially the whole cost - one
# forward pass per retrieved candidate, repeated for every re-search round -
# and the GPU is the difference between a fast search and a slow one.
#
# Until v1.10.0 this flag was RAG_EMBED_GPU and reached only the embedder, so
# turning it on genuinely did nothing for query latency and the note here said
# so. That was a missing argument, not a fact about GPUs. The old name still
# works - it meant "use my GPU" and now gets all of it.
#
# If you are here to make a per-row classification job faster, this is still
# only half the answer - see RAG_CHAT_MAX_SEARCHES and POST /classify.
#
# Needs onnxruntime-gpu, which REPLACES onnxruntime rather than sitting beside
# it - the two share an install directory, so having both installed silently
# shadows the GPU build and uninstalling either breaks the other. Install it
# deliberately, after the normal requirements:
#
#     pip uninstall -y onnxruntime
#     pip install --force-reinstall "onnxruntime-gpu[cuda,cudnn]"
#
# The [cuda,cudnn] extras are not optional: the bare wheel bundles neither, and
# without them onnxruntime offers CUDAExecutionProvider, accepts it, then logs
# "Failed to create CUDAExecutionProvider. Require cuDNN 9.* and CUDA 13.*" and
# runs on the CPU - which is indistinguishable from having no GPU.
#
# and match the build to the CUDA on the machine: the default PyPI wheel wants
# CUDA 13, while CUDA 12 hosts need
#     pip install onnxruntime-gpu --extra-index-url \
#       https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/
#
# When the driver libraries are missing, onnxruntime logs a warning and runs on
# the CPU rather than failing - which means a benchmark can show a "speedup"
# that is CPU both times. GET /health reports `embed_provider` and
# `rerank_provider`, which are what onnxruntime actually chose; check both say
# CUDAExecutionProvider before believing any number, and
#
#     python -m app.gpucheck
#
# proves it properly, with a negative control and a check that GPU and CPU
# still rank identically.
#RAG_GPU=1

# Which CUDA device, on a host with more than one. Default 0.
#
# Worth setting deliberately on a shared box. A provider named as a bare string
# means device 0, so every process that never thought about this piles onto the
# same card - typically the one someone else is training on. Asking for a device
# that does not exist does not fail either: onnxruntime falls back to the CPU,
# which is why /health reports embed_device and rerank_device as the session
# actually bound them rather than as requested.
#RAG_GPU_DEVICE=1

# --- staying current --------------------------------------------------------
# The file watcher re-indexes a file seconds after it changes, and drops it when
# it is deleted or moved away. It lives inside the server process, so it only
# runs while the server does - see `rag-up autostart` for keeping that true.
# Defaults ON for a local disk, OFF for a UNC path: SMB does not deliver change
# notifications dependably, and a watcher that silently misses edits is worse
# than none, because the index looks live while going stale.
#RAG_WATCH=1
#RAG_WATCH_DEBOUNCE=2.0

# Reconcile the index against the corpus at startup: files added, edited or
# deleted while the server was down are invisible to the watcher, and would
# otherwise stay wrong until someone reindexed by hand. Unchanged files are
# skipped on modification time, so this normally costs a directory walk and no
# embedding at all.
#RAG_RECONCILE_ON_START=1

# Minutes between periodic reconciles. Unset picks a default from RAG_WATCH:
# 0 when the watcher is trusted, 15 when it is not - which is what keeps a
# network share current. 0 disables it.
#RAG_RESCAN_MINUTES=15

# The work queue. Changes the watcher sees are written here before they are
# indexed, so a file still being written by the application that owns it - or a
# process killed mid-embed - costs a retry instead of a permanently stale
# index. Attempts back off 5s, 10s, 20s...; after RAG_QUEUE_MAX_ATTEMPTS the
# item is parked in a dead-letter table and listed by GET /queue, where it can
# be fixed and requeued with POST /queue/retry.
#RAG_QUEUE_MAX_ATTEMPTS=5
#RAG_QUEUE_BATCH=25
#RAG_QUEUE_POLL=2.0
#RAG_QUEUE_PATH=.data/ingest-queue.db

# Widen a retrieved chunk to the rest of the section it sits under before
# handing it to a generator. A chunk is a retrieval unit, not a unit of
# meaning: the paragraph that matched is often the middle of the argument.
# Costs budget, so it competes with breadth - turn it off for wide surveys.
#RAG_CONTEXT_EXPAND=1

# --- the chat pane ----------------------------------------------------------
# Which model writes the answers. Unset is the default and not a placeholder:
# search works exactly as before without it, the browser UI hides the Chat tab,
# and POST /chat answers 501. Set one of:
#   anthropic  the Claude API. Needs RAG_CHAT_API_KEY and an internet route.
#   openai     any OpenAI-compatible /chat/completions endpoint - OpenAI and
#              its Codex models, and equally llama.cpp's server, LM Studio,
#              vLLM, text-generation-webui, or Ollama's compatibility shim.
#   ollama     Ollama's own /api/chat, for a model on this machine or the
#              local network.
# Whichever you choose, retrieval stays here: the index, the embeddings and
# the documents never leave this process. What is sent is the question and the
# passages that answered it - which for a cloud provider means your documents
# do leave the machine, a paragraph at a time. The Chat tab says so on screen.
#RAG_CHAT_PROVIDER=ollama

# Required for openai and ollama; defaults to claude-opus-5 for anthropic.
# Use the name the server itself knows - `ollama list` for Ollama.
#RAG_CHAT_MODEL=gemma3:12b

# Base URL. Ignored for anthropic. Defaults: https://api.openai.com/v1 for
# openai, http://127.0.0.1:11434 for ollama. Point it anywhere that speaks the
# protocol - a colleague's workstation, a GPU box on the LAN.
#RAG_CHAT_URL=http://gpu-box.example.lan:11434

# Only needed for a service that authenticates. A local runner usually does
# not. This is the one setting `rag-up package` strips from the packaged .env.
#RAG_CHAT_API_KEY=

# Ceiling on one answer. Generous because the newer Claude models count their
# own reasoning against this budget, so a tight limit truncates the answer
# rather than merely shortening it.
#RAG_CHAT_MAX_TOKENS=4096
# Low deliberately: the job is to report what the passages say, not to write
# around them. Not sent to the Claude models, which reject sampling parameters.
#RAG_CHAT_TEMPERATURE=0.2
# Seconds to wait for a whole answer. A 7B model on CPU is slow.
#RAG_CHAT_TIMEOUT=180

# Retrieval for one chat turn: how many chunks are fetched, and how many
# characters of them survive into the prompt. Raise the budget for a model
# with a large context window; lower it for a small local one.
#RAG_CHAT_TOP_K=8
#RAG_CHAT_CONTEXT_CHARS=12000
# Prior turns replayed to the model, so pronouns and follow-ups work. The
# passages are the expensive part of each prompt, so this stays short - and
# older turns' passages are never re-sent.
#RAG_CHAT_HISTORY_TURNS=6

# --- keyword search and the entity graph ------------------------------------
# A SQLite file beside the vector store (.data/graph.db) holding a BM25 index
# over the same chunks and which entities appear in which chunk. Standard
# library only - no extra dependency, no daemon, nothing added to an offline
# install. Built during ingest, so a corpus indexed before this existed needs
# `reindex -Full` to populate it.
#RAG_GRAPH=1
#RAG_GRAPH_PATH=.data/graph.db

# Fuse BM25 with the vector ranking rather than using vectors alone. This is
# what makes exact strings findable - ticket IDs, part numbers, error codes -
# which is the one thing embeddings are reliably bad at. Rankings are combined
# by reciprocal rank fusion; RRF_K damps how much a single arm's top hit can
# dominate. Query-time only, no reindex needed.
#RAG_HYBRID=1
#RAG_RRF_K=60

# Multi-hop expansion: resolve the names in a question to entities, walk out
# through the documents they share, and add those chunks as candidates. 0 keeps
# it opt-in per request (`"hops": 1` in the body) - it is recall for "who else
# was involved in this", and noise for "what does this sentence mean".
#RAG_GRAPH_HOPS=0
#RAG_GRAPH_FANOUT=8

# An entity in more than this share of the documents is treated as boilerplate
# and dropped from the graph at query time: a header, a footer, or the corpus's
# own subject connects everything to everything. Raise it toward 1.0 for a
# corpus of unrelated documents; lower it if generic terms keep surfacing.
# Note the effect on a single-subject corpus: index one book and its main
# characters appear in most chapters, so the default hides exactly the names
# you would search for. Query-time only, no reindex needed.
#RAG_GRAPH_MAX_DF=0.2

# Which label is embedded alongside a chunk's own text.
#   symbol  - the chunk's first line (default)
#   section - the heading it sits under
#   off     - neither
# `section` is the one that ought to win, and when measured it did not: on a
# heading-rich corpus, identical with reranking on and slightly worse with it
# off. The knob exists because that was ten questions on one corpus, which is
# evidence rather than proof - try it on yours with `--compare` below before
# believing either answer. Changing this changes every vector: reindex -Full.
#RAG_EMBED_LABEL=symbol

# --- searching for what the page calls it -----------------------------------
# Retrieval matches your wording against the document's. When the two differ
# for the same thing, the passage that answers you is missing entirely and
# nothing says so: a question about "the System" cannot reach a page lettered
# DAILY QUEST. Two extra BM25 passes over SQLite address it - the question with
# its scaffolding stripped, then the vocabulary the first pass turned up. No
# model involved, so it works with any chat backend or none, and it improves
# /search and /context as much as the chat pane.
#RAG_EXPAND=1
#RAG_EXPAND_FEEDBACK_DOCS=5
#RAG_EXPAND_TERMS=8
# A harvested word in more than this share of the corpus is furniture rather
# than subject matter. There is a floor too, at 3 chunks: on OCR'd text the
# rarest words are scanning errors, so "rarest" alone selects for garbage.
#RAG_EXPAND_MAX_SHARE=0.08

# How many times the chat model may ask for a different search before it has to
# answer with what it has. It is told it may reply "SEARCH: <terms>" when the
# passages do not answer, using the words the documents would use - which is
# the one thing the deterministic passes above cannot do, because the bridging
# vocabulary is in neither the question nor the first results. Costs a full
# generation per round. 0 turns it off.
#RAG_CHAT_MAX_SEARCHES=2

# --- what gets indexed ------------------------------------------------------
# Extra plain-text extensions, no code change needed. The language tag defaults
# to the extension without its dot; "=tag" names it explicitly.
#RAG_EXTRA_TEXT_EXTS=.sql,.ini,.log
#RAG_EXTRA_TEXT_EXTS=.sql=sql,.cfg=conf

# Keep PDF running headers/footers instead of stripping them. Off by default:
# a footer repeated on every page lands in every chunk and flattens retrieval.
#RAG_PDF_KEEP_BOILERPLATE=1

# --- keeping extracted text between rebuilds --------------------------------
# Indexing is two jobs of very different cost: turning a PDF into text takes
# seconds - minutes with OCR - while chunking and embedding that text takes
# milliseconds. A full reindex used to redo both, which is why `reindex -Full`
# on a scanned corpus cost over an hour and a half here. It exists for when
# chunking or embedding changes, and neither alters what the words on the page
# are, so the extracted text is kept and reused.
#
# Measured on 12 scanned PDFs: 215s to extract cold, 0.1s on the rebuild, with
# byte-identical output. The first rebuild after enabling this still pays once,
# because there is nothing cached yet.
#
# Keyed by the SHA-256 of the file's bytes and by every setting that changes
# extraction - so it survives `reindex -Full` (which is exactly when timestamps
# should not be trusted), and turning OCR on or changing its confidence
# invalidates it without discarding the old entries.
#
# It holds verbatim document text, like the keyword index: never committed,
# never packaged, dropped by `down -Wipe`.
#RAG_EXTRACT_CACHE=1
#RAG_EXTRACT_CACHE_PATH=.data/extract-cache.db
# Compressed, so this goes a long way - prose runs about four to one. The
# coldest entries are dropped when it is exceeded.
#RAG_EXTRACT_CACHE_MAX_MB=2048

# --- OCR: pages whose text is pixels ----------------------------------------
# Scans, photographed reports, comics. Their words are on the page but not in
# the file, so without this they index as empty - and a search that finds
# nothing looks the same whether the corpus lacks the answer or the reader
# could not see it. With OCR off you at least get a log line saying how many
# pages were skipped for having no text layer.
#
# Off by default because it is about a thousand times slower than reading a
# text layer - seconds per page against microseconds. Measured here: 2.8s and
# ~500 characters per page, so a 5,000-page folder of scans is roughly four
# hours, once. Modification times mean a later reconcile never redoes it;
# `reindex -Full` does, so avoid that on a scanned corpus.
#
# Only pages with no text layer are read, so a typed report with scanned
# appendices costs OCR on the appendices alone. Enabling this also makes .cbz
# comic archives readable, which are page images and nothing else.
#RAG_OCR=1

# A page yielding fewer than this many characters counts as scanned. Not zero:
# a scanned page often carries a stray ligature or a stamped number in its text
# layer while the actual words are pixels.
#RAG_OCR_MIN_CHARS=20

# Tall pages are sliced into bands and read at native resolution, never shrunk
# to fit. A 20,000px webtoon strip squeezed into the detector's window comes
# back as "LMNG CANNOTENTERUN-ESS"; sliced, the same page reads "LIVING CANNOT
# ENTER UNLESS", for about 20% more time. The overlap keeps a line that falls
# across a cut from being lost, and the duplicate it creates is removed.
#RAG_OCR_BAND=2200
#RAG_OCR_OVERLAP=200

# Readings below this score are dropped. Artwork is why: a detector pointed at
# a drawing finds "text" in hatching and panel borders, scored low and meaning
# nothing. Raise it if junk is getting in, lower it if faint scans are missed.
#RAG_OCR_MIN_CONFIDENCE=0.5

# A guard against a corrupt page claiming an enormous size and exhausting
# memory during render - not a resolution setting.
#RAG_OCR_MAX_MEGAPIXELS=80

# Index documents found inside .zip archives (one level deep, never nested).
#RAG_ARCHIVES=1
#RAG_ARCHIVE_MAX_BYTES=500000000
#RAG_ARCHIVE_MAX_MEMBERS=2000

# --- storage ----------------------------------------------------------------
# Where the embedded vector index and the downloaded model weights live.
#RAG_QDRANT_PATH=./.data/qdrant
#RAG_MODEL_CACHE=./.data/models
# Set this to talk to a Qdrant server instead of the embedded store.
#RAG_QDRANT_URL=http://127.0.0.1:6333

# --- behaviour --------------------------------------------------------------
#RAG_PORT=8404
# Live re-index on file save (2s debounce). Set to 0 on a slow filesystem.
#RAG_WATCH=1
# Index automatically when the collection is empty on startup.
#RAG_INGEST_ON_START=1
# Comma-separated. Defaults already skip .git, target, node_modules, .venv,
# .data and archive/ — add your own here (this REPLACES the default list).
#RAG_EXCLUDE_DIRS=.git,target,node_modules,.venv,.data,archive
